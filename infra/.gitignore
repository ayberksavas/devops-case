# Local provider plugins
.terraform/
# Note: .terraform.lock.hcl IS committed so provider versions are reproducible.

# Local state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Real variable values — only the .example is tracked
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Plan files
*.tfplan
